{
  "name": "garden-of-shadows-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dialogue:compile": "npm run dialogue:compile:west && npm run dialogue:compile:north && npm run dialogue:compile:front && npm run dialogue:compile:pavilion",
    "dialogue:compile:west": "inkjs-compiler app/game/narrative/west-onboarding.ink -o app/game/narrative/west-onboarding.json",
    "dialogue:compile:north": "inkjs-compiler app/game/narrative/north-tower-ledger.ink -o app/game/narrative/north-tower-ledger.json",
    "dialogue:compile:front": "inkjs-compiler app/game/narrative/front-hall-guest.ink -o app/game/narrative/front-hall-guest.json",
    "dialogue:compile:pavilion": "inkjs-compiler app/game/narrative/sealed-pavilion.ink -o app/game/narrative/sealed-pavilion.json",
    "validate:content": "vitest run app/game/narrative/dialogue.test.ts app/game/runtime/ObjectiveDirector.test.ts app/game/manifests/campaign.test.ts app/game/manifests/north-tower-ledger.test.ts",
    "prebuild": "npm run dialogue:compile && npm run validate:content",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "inkjs": "^2.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "wrangler": "4.92.0"
  }
}
