{
  "name": "garden-of-shadows-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "assets:inventory": "node scripts/assets/inventory.mjs",
    "assets:fetch-cc0": "node scripts/assets/fetch-cc0.mjs",
    "assets:fetch-nature": "node scripts/assets/fetch-quaternius-nature.mjs",
    "assets:validate": "node scripts/assets/validate-assets.mjs",
    "assets:approve": "node scripts/assets/approve-assets.mjs",
    "assets:prepare": "node scripts/assets/prepare-runtime.mjs",
    "assets:build-blender": "node scripts/assets/run-blender.mjs",
    "visual:capture": "node scripts/visual/capture-regression.mjs",
    "visual:verify": "node scripts/visual/verify-regression.mjs",
    "visual:verify-release": "node scripts/visual/verify-regression.mjs --release",
    "dialogue:compile": "inkjs-compiler app/game/narrative/west-onboarding.ink -o app/game/narrative/west-onboarding.json",
    "validate:content": "vitest run app/game/narrative/dialogue.test.ts app/game/runtime/ObjectiveDirector.test.ts app/game/runtime/tingyuxuan-layout.test.ts app/game/runtime/chapter-behavior.test.ts app/game/runtime/west-chapter-walkthrough.test.ts app/game/manifests/campaign.test.ts app/game/campaign-save.test.ts",
    "dialogue:compile": "npm run dialogue:compile:west && npm run dialogue:compile:north",
    "dialogue:compile:west": "inkjs-compiler app/game/narrative/west-onboarding.ink -o app/game/narrative/west-onboarding.json",
    "dialogue:compile:north": "inkjs-compiler app/game/narrative/north-tower-ledger.ink -o app/game/narrative/north-tower-ledger.json",
    "validate:content": "vitest run app/game/narrative/dialogue.test.ts app/game/runtime/ObjectiveDirector.test.ts app/game/manifests/campaign.test.ts app/game/manifests/north-tower-ledger.test.ts",
    "prebuild": "npm run dialogue:compile && npm run validate:content",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/basis"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "inkjs": "^2.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@gltf-transform/cli": "4.4.2",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "meshoptimizer": "1.2.0",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "wrangler": "4.92.0"
  }
}

